# Local Postgres via `docker compose up -d` (docker-compose.yml). Swap this
# for a managed Postgres URL (e.g. Supabase) if you'd rather not run Docker.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nyu_rag

# Your own key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Distinguishes this app's traces from other iris_otel-instrumented apps in
# the Iris dashboard (defaults to the generic "iris-instrumented-app" if unset).
IRIS_SERVICE_NAME=nyu-rag
